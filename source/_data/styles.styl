body
  overflow-x: hidden

.container
  max-width: 1000px
  margin: 0 auto

img, table, pre, code, blockquote
  max-width: 100%
  overflow-x: auto

//文章背板的颜色rgb
.main-inner > .sub-menu, .main-inner > .post-block, .main-inner > .tabs-comment, .main-inner > .comments, .main-inner > .pagination{
    background:rgba(255, 255, 255, 0);      //此处使用十六进制颜色代码，         也可以使用rgba进行调色，
                                //实际效果为白色透明色底板              rgba的第四参数即为透明度
                                
}
body{               //修改主体字体
  color:#CCCCCC;     //颜色
}
body ::selection{               //修改主体字体选中后
  color:#04f4f4;     //颜色
  background: rgba(4, 244, 244, 0.3);
}
.posts-expand .post-title-link {    //标题颜色
    color: #CCCCCC;                //首页文章标题颜色， （默认为灰辨识度不高）
}
.site-title {
    color: #CCCCCC;  
    font-family: Lato, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 1.375em;
    font-weight: normal;
    margin: 0;
}
.posts-expand .post-meta-container {    //标题下的日期颜色
    color: #04f4f4;             //此处修改为红色，可自行调用rgb调色
}
.post-toc .nav .active-current > a {
    border-bottom-color: #04f4f4; 
    color: #04f4f4; 
}
.post-toc .nav .active > a {
    border-bottom-color: #04f4f4;
    color: #04f4f4;
}
.sidebar-toc-active .sidebar-nav-toc, .sidebar-overview-active .sidebar-nav-overview {
    border-bottom-color: #04f4f4; 
    color: #04f4f4; 
    transition-delay: 0.2s; 
}
.sidebar-inner {
    background: rgba(20, 21, 22, 0.7);
    box-shadow: inset 0 0 6px #04f4f4;
}
//代码块
pre[class*="language-"].line-numbers {
    padding-left: 3.8em;
    background: #2d2d2dad;
    border-radius: 8px;
    box-shadow: inset 0 0 6px #04f4f4;
}
pre[class*="language-"].line-numbers ::selection {
  background: rgba(4, 244, 244, 0.3); /* 透明蓝绿色背景 */
  color: #ffffff;                    /* 白字 */
}
code {
    background:rgba(4, 244, 244, 0.12); /* 透明蓝绿色背景 */
    color: #ffffff !important;
}
/* 隐藏行号背景 */
.code-lang {
    font-size: 40px;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    right: 5px;
}
//菜单栏的调色
.menu {
    margin: 0;
    padding: 1em 0;
    text-align: center;
    background: #02d2cf17;
    border-radius: 0 0 10px 10px; /* 左上 右上 左下 右下 */
    box-shadow: inset 0 0 6px #04f4f4;
}
header.header {
    background: rgba(20, 21, 22, 0.7);
    border-radius: 10px 10px 10px 10px;
    box-shadow: initial;
}
.main-inner {
    background-color: rgba(20, 21, 22, 0.7);  //主体背景透明
    padding: 0px 40px 40px 40px;  //调整组件位置
    border-radius: 10px 10px 10px 10px;
}
.site-brand-container {
    background: rgba(20, 21, 22, 0);
    box-shadow: 0 0 16px rgb(2 210 243);
    border-radius: 10px 10px 0 0; /* 左上 右上 左下 右下 */
}
.menu-item a:hover, .menu-item a.menu-item-active {
    background: rgba(20, 21, 22, 0.7);
}
.main-menu .menu-item-active::after {
    background: #04f4f4;
    border-radius: 50%;
    content: ' ';
    height: 6px;
    margin-top: -3px;
    position: absolute;
    right: 15px;
    top: 50%;
    width: 6px;
}
.menu-item .badge {
    background: #2bf;
    border-radius: 10px;
    color: var(--content-bg-color);
    font-weight: bold;
    line-height: 1;
    margin-left: 0.35em;
    padding: 2px 5px;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.1);
}
.menu-item .badge:hover {
    background: #04f4f4; /* 悬停时的背景色，可以改为你喜欢的颜色 */
    color: white; /* 悬停时的文字颜色 */
    /* 其他悬停效果，比如阴影、边框等 */
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}
.search-popup {
    background: rgba(20, 21, 22, 0.7);
    box-shadow: 0 0 16px #04f4f4;
}
mark.search-keyword {
  background: transparent;
  border-bottom: 1px dashed #04f4f4;
  color: #fc6423;
  font-weight: bold;
}
.site-description {
    color: #04f4f4;
    font-size: 0.8125em;
    margin-top: 0;
}
.sidebar-toggle:hover .toggle-line {
    background: #04f4f4;
}
a {
    border-bottom: 1px solid #999;
    color: #2bf;
    cursor: pointer;
    outline: 0;
    text-decoration: none;
    overflow-wrap: break-word;
}
//归档字体
.post-title a {
    border-bottom: 0;
    color: #2bf !important;
    border-bottom-color: #999;
}
.post-title a:hover {
    border-bottom: 0;
    color: #cccccc !important;
    border-bottom-color: #cccccc;
}
.main-inner {
    margin-top: 0px;
    margin-bottom: 60px;
    padding: 25px;
    box-shadow: inset 0 0 16px #04f4f4;
    box-shadow:  0 0 16px #04f4f4;
}
//按钮颜色
.btn {
    background: #222222ad;
    border: 2px solid var(--btn-default-border-color);
    border-radius: 2px;
    color: #cccccc !important;
    display: inline-block;
    font-size: 0.875em;
    line-height: 2;
    padding: 0 20px;
    transition: background-color 0.2s ease-in-out;
    box-shadow: inset 0 0 6px #04f4f4;
    box-shadow:  0 0 6px #04f4f4;
}
.btn:hover {
    background:rgba(102, 102, 102, 0.7);
}
.back-to-top.back-to-top-on {
    cursor: pointer;
    opacity: 0.6;
    background:rgba(34, 34, 34, 0);
}
.back-to-top {
    font-size: 12px;
    margin: 8px -10px -20px;
    opacity: 0.6;
    background:rgba(34, 34, 34, 0);
    transition: opacity 0.2s ease-in-out;
}
//表格
th, td {
    border: 1px solid rgba(4, 244, 244, 0.5);
    border-bottom: 3px solid #04f4f4;
    background:rgba(34, 34, 34, 0);
}
//gitalk
.gt-container .gt-header-textarea {
    padding: 0.75em;
    display: block;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    width: 100%;
    min-height: 5.125em;
    max-height: 15em;
    border-radius: 5px;
    border: 1px solid #04f4f4 !important;
    font-size: 0.875em;
    word-wrap: break-word;
    resize: vertical;
    background-color:rgba(85, 85, 85, 0.7) !important;
    outline: none;
    -webkit-transition: all 0.25s ease;
    transition: all 0.25s ease;
}
.gt-container .gt-header-preview {
    background-color: rgba(246, 249, 254, 0.7) !important;
}
.gt-container .gt-header-preview:hover {
    background-color: rgba(246, 249, 254, 0.7) !important;
    box-shadow: 0 0 16px #04f4f4;

}
//评论
.gt-container .gt-comment-admin .gt-comment-content {
