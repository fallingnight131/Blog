    opacity: 0.7;
}
@media (max-width: 991px) {
    .sidebar {
        background: #222222ad;
        bottom: 0;
        box-shadow: inset 0 0 6px #04f4f4;
        max-height: 100vh;
        overflow-y: auto;
        position: fixed;
        top: 0;
        transition: 0.2s ease-out;
        transition-property: left, right;
        width: 320px;
        z-index: 20;
        border-radius: 0 10px 10px 0;
    }  
}
@media (max-width: 991px) {
    .main-inner {
        padding: 20px;
        border-radius: 0 0 10px 10px;
        box-shadow: 0 0 16px #04f4f4;
    }
}
@media (max-width: 991px) {
    .site-brand-container {
        box-shadow: 0 0px 16px #04f4f4;
        border-radius: 0px 0px 0 0; /* 左上 右上 左下 右下 */
    }
    .site-nav-on .site-brand-container {
        box-shadow: 0 0 16px #04f4f4;
    }
    header.header {
    background: rgba(20, 21, 22, 0.7);
    border-radius: 10px 10px 0 0;
    box-shadow: initial;
  }
  @media (max-width: 767px) {
    body.site-nav-on .site-nav {
        height: var(--scroll-height);
        visibility: unset;
        border-radius: 10px;
        border-radius: 0 0 10px 10px;
    }
  }
  
}
@media (max-width: 991px) {
    .search-popup .search-header {
        background: #666666ad;
        box-shadow:  0 0 6px #04f4f4;
    }
    .search-popup {
    background: rgba(20, 21, 22, 0.7);
    box-shadow: inset 0 0 6px #04f4f4;
    }
}
@media (max-width: 991px) {
    .links-of-author a::before {
        display: inline-block;
        margin-right: 3px;
        transform: translateY(-2px);
        content: " ";
        height: 4px;
        width: 4px;
        background: #04f4f4;
        border-radius: 50%;
    }
}
@media (max-width: 991px) {
    .menu {
        margin: 0;
        padding: 1em 0;
        text-align: center;
        background: #02d2cf17;
        border-radius: 10px 10px 10px 10px;
    }
    .sidebar-inner {
    background: rgba(20, 21, 22, 0);
    box-shadow: inset 0 0 0 #04f4f4;
    }
}
//隐藏
.hide
  transition .1s
  background #000
  padding -1px
  p
    display inline
  code
    box-sizing border-box
  &:hover
    code
      border 1px solid var(--theme-border-soft)
  &:not(:hover)
    color #000
    code
      border 1px solid transparent
      background #000
    strong, em, p, i, a
      color #000
    strong, em, p, i, a, span
      transition .1s
//引用
.quot  
  display: flex;  
  align-items: center;  
  justify-content: center;  
  
.quot p  
  display: inline;  
  margin: 0;  
  font-size 1.3em;  
  font-family 'REEJI-CloudDaBiaoSongGBT', 'Times New Roman'  
  color var(--theme-border-light)  
  
.quot:before, .quot:after  
  content: "";  
  display: inline-block;  
  height: 2em; /* 调整图标的高度 */  width: 2em; /* 调整图标的宽度 */  margin: 5px 5px;  
  
.quot.one:before  
  background url('../img/left-1.png') no-repeat center/contain  
  
.quot.one:after  
  background url('../img/right-1.png') no-repeat center/contain

//github章鱼猫
.github-corner svg {
    color:rgba(4, 244, 244, 0.7);
    fill: rgba(20, 21, 22, 0.7);
}
.book-mark-link {
    display: none;
}
//友链小卡片
@property --card-border
  syntax '<color>'
  inherits true
  initial-value transparent

.link-card
  display inline-block
  width 320px
  padding unset
  margin .5em 1em
  position relative
  z-index 1
  &:hover
    background-color var(--theme-bg-soft-hover)
    &::before
      --card-border var(--theme-highlight)
    .link-main
      border-left 2px solid var(--theme-highlight)
  img
    max-height 100%
    max-width 100%
    display block
    border-bottom 1px solid var(--theme-border-soft)
    margin-bottom -1px

.link-card::before
  content ''
  position absolute
  left 0
  top 0
  width 100%
  height 100%
  transition --card-border .3s
  box-shadow 0 0 5px inset var(--card-border)

.link-main
  transition border-color .3s
  background-color var(--theme-bg-soft)
  border-left 2px solid var(--theme-text-light)
  border-block inset 1px solid var(--theme-border-soft)
  display flex
  align-items center
  height 4em
  padding .5em
  .link-ico
    height 50px
    width 50px
    img
      border-radius 50%
    &.link-full
      width 100%
      display flex
      justify-content center
  .link-data
    padding 0 .5em
    width calc(100% - 50px)
    box-sizing border-box
    &.link-full
      width 100%
  .link-title
    color var(--theme-text-light)
    font-size 1.2em
  .link-descr
    color var(--theme-text)
    font-family BenderLight, FangSong, sans-serif
    height 36px
    overflow hidden
    text-overflow ellipsis
    display: -webkit-box
    -webkit-line-clamp 2
    -webkit-box-orient vertical
    &.link-full
      height 54px
      -webkit-line-clamp 3

.link-main.link-simple
  height 3em

.link-background
  position relative
  z-index -1

.link-container //自定义的一个类名，可以使link-card类元素的父div标签自动添加下边的样式
  display: flex
  justify-content: center
  text-align: center
  flex-wrap: wrap; //自动换行

//提示
.tip  
  display flex  
  align-items center  
  padding: 10px;  
  margin 5px 5px 0 0  
  color #ffffff //普通的文本颜色会显得比较暗  
  &.success  
    background-color rgba(0,255,0,0.7)  
    border-left 5px solid rgb(0,255,0)  
  &.warning  
    background-color rgba(255,255,0,0.7)  
    border-left 5px solid rgb(255,255,0)  
  &.failure  
    background-color rgba(255,0,0,70%)  
    border-left 5px solid rgb(255,0,0)  
  .icon  
    margin-right 0.8em  
    transform scale(1.3)  
  .p  
    flex 1 /* 占据剩余空间 */

//音乐信息
.aplayer {
    color: #777777 !important;
    background:rgba(255, 255, 255, 0.7) !important;
    box-shadow: 0 2px 2px 0 #04f4f4, 0 1px 5px 0 #04f4f4 !important;
}

/* 歌单整体字体和对齐 */
.aplayer-list ol li {
    display: flex;                  /* 使用 flex 布局 */
    justify-content: space-between; /* 两边对齐 */
    align-items: center;            /* 垂直居中 */
    padding: 4px 8px;               /* 调整内边距 */
    font-size: 14px;                /* 字体大小 */
}

/* 歌名（左侧） */
.aplayer-list ol li .aplayer-list-title {
    flex: 1;                /* 占据剩余空间 */
    min-width: 0;           /* 允许收缩到0，配合省略号 */
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 歌手（右侧） */
.aplayer-list ol li .aplayer-list-author {
    flex: 0 0 70px;         /* 固定宽度80px，可根据实际调整 */
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

