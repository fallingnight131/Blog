  position: fixed
  top: 0
  left: 0
  width: 100vw
  height: 100vh
  //background: url("https://fallingnight131.oss-cn-shanghai.aliyuncs.com/blog/image/background_202504181448.png") no-repeat center center
  //background: url("https://fallingnight131.oss-cn-shanghai.aliyuncs.com/blog/image/background.jpg") no-repeat center center
  background: url("https://fallingnight131.oss-cn-shanghai.aliyuncs.com/blog/image/background1.jpg") no-repeat center center
  //background: url("https://fallingnight131.oss-cn-shanghai.aliyuncs.com/blog/image/background2.jpg") no-repeat center center
