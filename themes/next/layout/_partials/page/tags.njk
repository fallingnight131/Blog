<div class="tag-cloud">
  <div class="tag-cloud-title">
    {{ _p('counter.tag_cloud', site.tags.length) }}
  </div>

  {# 球形标签云 - 全端显示 #}
  <div class="tag-cloud-3d" style="width:100%;max-width:720px;margin:0 auto;">
    <div class="tags" id="myTags">
      <canvas id="my3DTags" style="display:block;width:100%;height:auto;margin:0 auto;"></canvas>
    </div>
    <div class="tags" id="tags">
      <ul style="display: none">
        {{ tagcloud({
          min_font   : 16,
          max_font   : 35,
          amount     : 999,
          color      : false
          })
        }}
      </ul>
    </div>
  </div>
</div>

<script data-pjax>
  (function() {
    var ROOT = '{{ theme.root | default(config.root) }}';

    function applyGradientColors() {
      var links = document.querySelectorAll('#tags ul a');
      if (!links.length) return;
      for (var i = 0; i < links.length; i++) {
        var hue = 180 + Math.round((i / links.length) * 30);
        links[i].style.color = 'hsl(' + hue + ', 80%, 55%)';
      }
    }

    function resizeCanvas() {
      var canvas = document.getElementById('my3DTags');
      if (!canvas) return;
      var container = canvas.parentElement.parentElement;
      var size = Math.min(container.clientWidth, 720);
      canvas.width = size;
      canvas.height = size;
    }

    function startTagCanvas() {
      applyGradientColors();
      resizeCanvas();
      try {
        TagCanvas.Start('my3DTags', 'tags', {
          textFont: 'Georgia,Optima',
          textColour: null,
          outlineColour: '#cccccc',
          weight: true,
          reverse: true,
          depth: 0.8,
          maxSpeed: 0.05,
          bgRadius: 1,
          freezeDecel: true
        });
      } catch (e) {
        var myTags = document.getElementById('myTags');
        if (myTags) myTags.style.display = 'none';
      }
    }

    function loadScript(src, cb) {
      var s = document.createElement('script');
      s.src = src;
      s.onload = cb;
      document.body.appendChild(s);
    }

    function initTagCanvas() {
      if (typeof TagCanvas !== 'undefined') {
        startTagCanvas();
      } else {
        loadScript(ROOT + 'js/tagcanvas.js', function() {
          startTagCanvas();
        });
      }
    }

    // 首次加载 & PJAX 导航均触发
    initTagCanvas();
    document.addEventListener('pjax:complete', initTagCanvas);
    document.addEventListener('pjax:end', initTagCanvas);
  })();
  
  document.addEventListener('DOMContentLoaded', disablePjaxForTagLinks);
  document.addEventListener('pjax:complete', disablePjaxForTagLinks);
</script>