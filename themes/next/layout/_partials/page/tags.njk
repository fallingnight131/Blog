<div class="tag-cloud">
  <div class="tag-cloud-title">
    {{ _p('counter.tag_cloud', site.tags.length) }}
  </div>
  
  {# 普通标签云 - 移动端显示 #}
  <div class="tag-cloud-tags mobile-tag-cloud">
    {{ tagcloud({
      min_font: theme.tagcloud.min,
      max_font: theme.tagcloud.max,
      amount  : theme.tagcloud.amount,
      orderby : theme.tagcloud.orderby,
      order   : theme.tagcloud.order,
      class   : 'tag-cloud'
      })
    }}
  </div>
  
  {# 球形标签云 - PC端显示 #}
  <div class="pc-tag-cloud">
    <div class="tags" id="myTags">
      <canvas width="720" height="720" id="my3DTags" style="display: block;margin: 0 auto;">
      </canvas>
    </div>
    <div class="tags" id="tags">
      <ul style="display: none">
        {{ tagcloud({
          min_font   : 16,
          max_font   : 35,
          amount     : 999,
          color      : true,
          start_color: '#04f4f4',
          end_color  : '#22bbff'
          })
        }}
      </ul>
    </div>
  </div>
</div>

{# 处理响应式显示和初始化 #}
<style>
  @media (max-width: 767px) {
    .pc-tag-cloud {
      display: none;
    }
  }
  
  @media (min-width: 768px) {
    .mobile-tag-cloud {
      display: none;
    }
  }
</style>

<script data-pjax>
  (function() {
    var ROOT = '{{ theme.root | default(config.root) }}';

    function startTagCanvas() {
      if (!window.matchMedia('(min-width: 768px)').matches) return;
      try {
        TagCanvas.Start('my3DTags', 'tags', {
          textFont: 'Georgia,Optima',
          textColour: null,
          outlineColour: '#cccccc',
          weight: true,
          reverse: true,
          depth: 0.8,
          maxSpeed: 0.05,
          bgRadius: 1,
          freezeDecel: true
        });
      } catch (e) {
        var myTags = document.getElementById('myTags');
        if (myTags) myTags.style.display = 'none';
      }
    }

    function loadScript(src, cb) {
      var s = document.createElement('script');
      s.src = src;
      s.onload = cb;
      document.body.appendChild(s);
    }

    function initTagCanvas() {
      if (typeof TagCanvas !== 'undefined') {
        startTagCanvas();
      } else {
        loadScript(ROOT + 'js/tagcanvas.js', function() {
          startTagCanvas();
        });
      }
    }

    // 首次加载 & PJAX 导航均触发
    initTagCanvas();
    document.addEventListener('pjax:complete', initTagCanvas);
    document.addEventListener('pjax:end', initTagCanvas);
  })();
  
  document.addEventListener('DOMContentLoaded', disablePjaxForTagLinks);
  document.addEventListener('pjax:complete', disablePjaxForTagLinks);
</script>